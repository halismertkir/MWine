#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
# Scan Git history + staged files locally. Never scan ignored accounts/prefixes.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
WORK="$(mktemp -d "${TMPDIR:-/tmp}/mwine-secrets.XXXXXX")"
trap 'rm -rf "$WORK"' EXIT
VERSION=8.30.1
case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) PLATFORM=darwin_arm64; HASH=b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5 ;;
  Linux-x86_64) PLATFORM=linux_x64; HASH=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb ;;
  *) printf 'Secret check supports Apple Silicon macOS and Linux x64.\n' >&2; exit 2 ;;
esac
curl --fail --silent --show-error --location --retry 2 --connect-timeout 20 --max-time 120 \
  "https://github.com/gitleaks/gitleaks/releases/download/v$VERSION/gitleaks_${VERSION}_${PLATFORM}.tar.gz" -o "$WORK/scanner.tar.gz"
ACTUAL="$(shasum -a 256 "$WORK/scanner.tar.gz" | cut -d ' ' -f 1)"
[[ "$ACTUAL" == "$HASH" ]] || { printf 'Scanner checksum mismatch.\n' >&2; exit 1; }
tar -xzf "$WORK/scanner.tar.gz" -C "$WORK" gitleaks
cd "$ROOT"
"$WORK/gitleaks" git . --log-opts='--all' --redact --no-banner
mkdir -p "$WORK/staged"
git checkout-index --prefix="$WORK/staged/" -a
"$WORK/gitleaks" dir "$WORK/staged" --redact --no-banner
